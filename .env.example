# ==========================================
# Intellizo Softwares MCP Server Environment
# ==========================================

# Server Host and Port
MCP_HOST=127.0.0.1
MCP_PORT=8000

# MCP Endpoint Path
MCP_PATH=/mcp

# Transport: streamable-http (default for web/ChatGPT), stdio, or sse
MCP_TRANSPORT=streamable-http

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional explicit path to data.json knowledge base
# Leave blank to automatically resolve relative to project root
DATA_JSON_PATH=./data.json
