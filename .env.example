# ==========================================
# Intellizo Softwares MCP Server Environment
# ==========================================

# Server Host and Port
MCP_HOST=0.0.0.0
MCP_PORT=8000

# MCP Endpoint Path
MCP_PATH=/mcp

# Transport: streamable-http (default for web/ChatGPT), stdio, or sse
MCP_TRANSPORT=streamable-http

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional explicit path to data.json knowledge base.
# Leave blank/commented out to automatically resolve across Render, Docker, Vercel, and local environments.
# DATA_JSON_PATH=

